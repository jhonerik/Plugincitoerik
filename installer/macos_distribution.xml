<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Instalador de ClipSampler v2.6.1 (Español)</title>
    <options customize="always" require-scripts="false" hostArchitectures="x86_64,arm64" />
    
    <!-- Políticas de Usuario y Acuerdo de Licencia en Español -->
    <license file="license.txt" mime-type="text/plain" />
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true" />
    
    <!-- ====================================================================== -->
    <!-- MENÚ DE SELECCIÓN EN ESPAÑOL: VST3, AAX Y MANUAL OFICIAL EN PDF        -->
    <!-- ====================================================================== -->
    <choices-outline>
        <line choice="choice_vst3" />
        <line choice="choice_aax" />
    </choices-outline>

    <!-- 1. Opción VST3 + Manual PDF -->
    <choice id="choice_vst3" 
            title="Plugin VST3 (64 bits) + Manual Oficial en PDF" 
            description="Instala el instrumento virtual ClipSampler en /Library/Audio/Plug-Ins/VST3/ClipSampler.vst3 y el Manual Oficial de Usuario en PDF (/Library/Application Support/ClipSampler/Manual_ClipSampler.pdf) para DAWs compatibles (Cubase, Ableton Live, Studio One, FL Studio, Reaper)."
            start_selected="true">
        <pkg-ref id="com.audioinnovations.clipsampler.vst3" />
    </choice>

    <!-- 2. Opción AAX (Pro Tools) -->
    <choice id="choice_aax" 
            title="Plugin AAX (Avid Pro Tools)" 
            description="Instala el instrumento virtual ClipSampler en /Library/Application Support/Avid/Audio/Plug-Ins/ClipSampler.aaxplugin para Avid Pro Tools."
            start_selected="true">
        <pkg-ref id="com.audioinnovations.clipsampler.aax" />
    </choice>

    <!-- Referencias de Paquetes -->
    <pkg-ref id="com.audioinnovations.clipsampler.vst3" version="2.6.1" onConclusion="none">ClipSampler_VST3.pkg</pkg-ref>
    <pkg-ref id="com.audioinnovations.clipsampler.aax" version="2.6.1" onConclusion="none">ClipSampler_AAX.pkg</pkg-ref>

</installer-gui-script>
