<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ClipSampler Audio Plugin</title>
    <options customize="always" require-scripts="false" hostArchitectures="x86_64,arm64" />
    
    <!-- Políticas de Usuario y Acuerdo de Licencia (EULA) -->
    <license file="license.txt" mime-type="text/plain" />
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true" />
    
    <!-- ====================================================================== -->
    <!-- MENÚ DE SELECCIÓN CON SOLAMENTE DOS OPCIONES: VST3 Y AAX               -->
    <!-- ====================================================================== -->
    <choices-outline>
        <line choice="choice_vst3" />
        <line choice="choice_aax" />
    </choices-outline>

    <!-- 1. VST3 Choice -->
    <choice id="choice_vst3" 
            title="VST3 Plugin" 
            description="Instala el instrumento virtual ClipSampler en /Library/Audio/Plug-Ins/VST3/ClipSampler.vst3 para DAWs compatibles (Cubase, Ableton Live, Studio One, FL Studio, Reaper)."
            start_selected="true">
        <pkg-ref id="com.audioinnovations.clipsampler.vst3" />
    </choice>

    <!-- 2. AAX Choice -->
    <choice id="choice_aax" 
            title="AAX Plugin (Pro Tools)" 
            description="Instala el instrumento virtual ClipSampler en /Library/Application Support/Avid/Audio/Plug-Ins/ClipSampler.aaxplugin para Avid Pro Tools."
            start_selected="true">
        <pkg-ref id="com.audioinnovations.clipsampler.aax" />
    </choice>

    <!-- Package References -->
    <pkg-ref id="com.audioinnovations.clipsampler.vst3" version="2.4.0" onConclusion="none">ClipSampler_VST3.pkg</pkg-ref>
    <pkg-ref id="com.audioinnovations.clipsampler.aax" version="2.4.0" onConclusion="none">ClipSampler_AAX.pkg</pkg-ref>

</installer-gui-script>
